{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chess Review",
  "version": "1.0.0",
  "identifier": "app.chessreview.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Chess Review",
        "width": 1360,
        "height": 880,
        "minWidth": 1000,
        "minHeight": 680,
        "center": true,
        "decorations": false,
        "transparent": false,
        "backgroundColor": "#302e2b",
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
